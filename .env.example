# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Auth (JWT) ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Admin credentials (change before deploying!) ─────────────────
ADMIN_EMAIL=admin@evprimitive.com
ADMIN_PASSWORD=ChangeMe123!

# ─── Database ─────────────────────────────────────────────────────
DB_PATH=./server/db/ev_primitive.sqlite

# ─── Media uploads ────────────────────────────────────────────────
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=20

# ─── Google Drive (optional — for Drive-sourced media) ────────────
# Download service account JSON from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=./server/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# ─── Site ─────────────────────────────────────────────────────────
SITE_NAME=EV Primitive
SITE_URL=https://evprimitive.com
