          <h1 class="quiz-step__question">Where will it live?</h1>
          <p class="quiz-step__sub">The location shapes everything that follows.</p>
          <div class="quiz-options">
            <button type="button" class="quiz-option" data-answer="location:backyard">
              <span class="quiz-option__title">Backyard</span>
              <span class="quiz-option__desc">Outdoor install at home, delivered and assembled on site.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="location:vacation">
              <span class="quiz-option__title">Vacation home</span>
              <span class="quiz-option__desc">Second property, weekend retreat. Delivered to a place you visit, not where you live.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="location:commercial">
              <span class="quiz-option__title">Commercial application</span>
              <span class="quiz-option__desc">Hotel, gym, member club, retreat. High daily use, often multiple installs.</span>
            </button>
          </div>
        </div>
      </section>

      <!-- STEP 2: PEOPLE -->
      <section class="quiz-step" data-step="2">
        <div class="container quiz-step__inner">
          <h1 class="quiz-step__question">Who’s it for?</h1>
          <p class="quiz-step__sub">Day-to-day capacity, not the biggest party.</p>
          <div class="quiz-options quiz-options--photo">
            <button type="button" class="quiz-option quiz-option--photo" data-answer="people:solo">
              <span class="quiz-option__media">
                <img width="1785" height="1800" src="/img/product-photos/Nook Sauna.jpg" alt="A NOOK sauna interior, single bench, tight footprint" loading="lazy" />
              </span>
              <span class="quiz-option__body">
                <span class="quiz-option__title">Compact</span>
                <span class="quiz-option__desc">1–2 people. Lay down. Tight footprint, daily ritual for one or two.</span>
              </span>
            </button>
            <button type="button" class="quiz-option quiz-option--photo" data-answer="people:small">
              <span class="quiz-option__media">
                <img width="1785" height="1800" src="/img/product-photos/212 Sauna.jpg" alt="A 212 sauna interior, communal bench layout" loading="lazy" />
              </span>
              <span class="quiz-option__body">
                <span class="quiz-option__title">Shared</span>
                <span class="quiz-option__desc">3–4 people. Friends and family. Communal bench, occasional gathering.</span>
              </span>
            </button>
            <button type="button" class="quiz-option quiz-option--photo" data-answer="people:large">
              <span class="quiz-option__media">
                <img width="1785" height="1800" src="/img/product-photos/Thermal Suite.jpg" alt="A Thermal Suite interior, full envelope, room to host" loading="lazy" />
              </span>
              <span class="quiz-option__body">
                <span class="quiz-option__title">Suite</span>
                <span class="quiz-option__desc">5+ people. The full envelope. Communal, regular shared ritual.</span>
              </span>
            </button>
          </div>
        </div>
      </section>

      <!-- STEP 3: COLD PLUNGE -->
      <section class="quiz-step" data-step="3">
        <div class="container quiz-step__inner">
          <h1 class="quiz-step__question">Cold plunge?</h1>
          <p class="quiz-step__sub">Cold completes the contrast loop. But it’s not required.</p>
          <div class="quiz-options">
            <button type="button" class="quiz-option" data-answer="cold:yes">
              <span class="quiz-option__title">Yes, same envelope</span>
              <span class="quiz-option__desc">Sauna and cold plunge in one structure. The full ritual loop.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="cold:add">
              <span class="quiz-option__title">Maybe later</span>
              <span class="quiz-option__desc">Start with sauna, add a standalone cold plunge down the line.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="cold:no">
              <span class="quiz-option__title">Sauna only</span>
              <span class="quiz-option__desc">No cold plunge. Sauna-only build.</span>
            </button>
          </div>
        </div>
      </section>

      <!-- STEP 4: BUDGET -->
      <section class="quiz-step" data-step="4">
        <div class="container quiz-step__inner">
          <h1 class="quiz-step__question">Where are you on budget?</h1>
          <p class="quiz-step__sub">Honest tier, before turnkey and site work.</p>
          <div class="quiz-options">
            <button type="button" class="quiz-option" data-answer="budget:entry">
              <span class="quiz-option__title">Under $30k</span>
              <span class="quiz-option__desc">Sauna-only entry point.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="budget:mid">
              <span class="quiz-option__title">$30k – $45k</span>
              <span class="quiz-option__desc">Sauna + add-ons, or a larger sauna alone.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="budget:high">
              <span class="quiz-option__title">$45k – $60k</span>
              <span class="quiz-option__desc">Sauna + cold plunge in one envelope.</span>
            </button>
            <button type="button" class="quiz-option" data-answer="budget:flagship">
              <span class="quiz-option__title">Flexible / open</span>
              <span class="quiz-option__desc">Best of the lineup, or fully custom.</span>
            </button>
          </div>
        </div>
      </section>

      <!-- STEP 5: RESULT + EMAIL GATE -->
      <section class="quiz-step quiz-step--result" data-step="5">
        <div class="container quiz-step__inner">
          <h1 class="quiz-step__question" data-result-name></h1>
          <p class="quiz-step__sub" data-result-desc></p>

          <div class="quiz-result">
            <figure class="quiz-result__media">
              <img data-result-img src="" alt="" />
            </figure>
            <div class="quiz-result__why">
              <p class="quiz-result__why-title">Why this match</p>
              <ul data-result-why></ul>
              <p class="quiz-result__price" data-result-price></p>
            </div>
          </div>

          <div class="quiz-gate">
            <h2 class="quiz-gate__title">Get your spec sheet</h2>
            <p class="quiz-gate__sub">Tell us where to send your spec sheet, we’ll save your recommendation and set up a time to talk.</p>
            <form class="quiz-gate__form" data-lead-form>
              <div class="quiz-gate__field">
                <label class="form__label" for="lead-name">Name</label>
                <input class="form__input" id="lead-name" name="name" type="text" required placeholder="Your name" autocomplete="name" />
              </div>
              <div class="quiz-gate__field">
                <label class="form__label" for="lead-email">Email</label>
                <input class="form__input" id="lead-email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
              </div>
              <div class="quiz-gate__field">
                <label class="form__label" for="lead-phone">Phone</label>
                <input class="form__input" id="lead-phone" name="phone" type="tel" required placeholder="(555) 555-5555" autocomplete="tel" />
              </div>
              <p class="quiz-gate__error" data-quiz-error role="alert" aria-live="assertive" hidden></p>
              <button class="btn btn--solid quiz-gate__submit" type="submit">Continue →</button>
              <p class="quiz-gate__note">We send your spec, not spam. One follow-up, then quiet.</p>
            </form>
          </div>
        </div>
      </section>

    </main>
