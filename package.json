{
  "name": "ev-primitive",
  "version": "1.0.0",
  "description": "EV Primitive — Tesla-inspired electric vehicle website with CMS backend and Framer Motion animations",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start":              "node server/index.js",
    "dev":                "nodemon server/index.js",
    "dev:client":         "vite",
    "build:animations":   "vite build",
    "seed":               "node server/db/seed.js",
    "setup":              "npm install && cp .env.example .env && npm run seed"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "better-sqlite3":     "^9.4.3",
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.5",
    "express":            "^4.18.3",
    "express-fileupload": "^1.4.3",
    "framer-motion":      "^11.1.7",
    "googleapis":         "^140.0.1",
    "jsonwebtoken":       "^9.0.2",
    "multer":             "^1.4.5-lts.1",
    "react":              "^18.3.1",
    "react-dom":          "^18.3.1",
    "sharp":              "^0.33.2",
    "uuid":               "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "nodemon":              "^3.1.0",
    "vite":                 "^5.2.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
